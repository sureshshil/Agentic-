# Copy to telegram_bot.env (next to telegram_bot.py) and fill in real
# values. This file is referenced by telegram-bot.service's
# EnvironmentFile= line - systemd loads it as plain KEY=VALUE pairs (no
# quotes, no "export").

ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_CHAT_ID=your-chat-id-here

# Optional - enables the web_search tool (Brave Web Search API):
# BRAVE_API_KEY=your-brave-key-here

# Optional - enables the send_email tool (Gmail App Password, see README):
# EMAIL_ADDRESS=you@gmail.com
# EMAIL_APP_PASSWORD=your-app-password-here
