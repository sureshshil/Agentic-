# Copy to telegram_bot.env (next to telegram_bot.py) and fill in real
# values. This file is referenced by telegram-bot.service's
# EnvironmentFile= line - systemd loads it as plain KEY=VALUE pairs (no
# quotes, no "export").

GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=global
# ^ Requires a GCP project with the Vertex AI API enabled and billing set
# up. GOOGLE_APPLICATION_CREDENTIALS can be omitted if you've instead run
# `gcloud auth application-default login` on this machine.

TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_CHAT_ID=your-chat-id-here

# Optional - enables the web_search tool (Brave Web Search API):
# BRAVE_API_KEY=your-brave-key-here

# Optional - enables the send_email tool (Gmail App Password, see README):
# EMAIL_ADDRESS=you@gmail.com
# EMAIL_APP_PASSWORD=your-app-password-here

# Optional - lifetime spending cap in USD before the bot refuses further
# calls (default 2.00 if unset):
# AGENT_MAX_COST_USD=2.00

# Optional - per-turn output token budget, shared with gemini-3.7-flash's
# adaptive thinking (default 4096 if unset). Raise this if replies get cut
# off with finish_reason="MAX_TOKENS":
# AGENT_MAX_TOKENS=8192
