# systemd unit for telegram_bot.py - keeps the bot running continuously,
# restarts it if it crashes, and starts it automatically on VM reboot.
#
# Install (see simple_agent/README.md's "Hosting on a cheap VPS" section
# for the full walkthrough):
#   cp deploy/telegram-bot.service /etc/systemd/system/telegram-bot.service
#   systemctl daemon-reload
#   systemctl enable --now telegram-bot
#
# Defaults assume you're logged in as root at /root/Agentic- (the default
# on Hetzner/DigitalOcean/Vultr Ubuntu images). Adjust User/WorkingDirectory
# /ExecStart/EnvironmentFile below to match your actual setup.

[Unit]
Description=Telegram bot for the simple_agent project
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Agentic-/simple_agent
EnvironmentFile=/root/Agentic-/simple_agent/telegram_bot.env
ExecStart=/root/Agentic-/simple_agent/.venv/bin/python telegram_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
