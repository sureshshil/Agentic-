# Copy to scheduled.env (anywhere - deploy/ is a reasonable spot) and
# fill in real values. These are the *extra* env vars rain_alert.py and
# news_digest.py need beyond what's already in telegram_bot.env -
# ANTHROPIC_API_KEY and ANTHROPIC_WORKSPACE_ID are reused as-is from
# there either way; BRAVE_API_KEY (used by news_digest_agent.py, via the
# real telegram_bot.Agent) or TAVILY_API_KEY (used by news_digest.py's
# own bespoke call) is too, whichever script you actually run.
#
# This file is sourced directly in the crontab command (see
# cron-notifications.md), not loaded by the scripts themselves - plain
# KEY=VALUE pairs, no quotes needed.

NTFY_TOPIC=your-ntfy-topic-here

# Optional - see rain_alert.py's and news_digest.py's own docstrings for
# what each defaults to if left unset:
# Where to check. ALERT_LAT/ALERT_LON skip geocoding entirely - use them
# for any place name more than one town shares (the script warns on
# stdout when a name is ambiguous, but coordinates are the only real fix).
# ALERT_LAT=35.80408
# ALERT_LON=139.81168
# ALERT_LABEL=Hanahata, Adachi-ku
# ALERT_LOCATION=Tokyo, Japan

# MET Norway's terms ask for a contact address in the User-Agent.
# ALERT_CONTACT=you@example.com

# Forecast mm in a single hour that counts as heavy. Values <= 0 mean
# "any measurable rain" (0.1 mm), not "alert on every run".
# RAIN_THRESHOLD_MM=7.5
# How many hours ahead to look - this is your umbrella lead time.
# ALERT_LOOKAHEAD_HOURS=6
# Stay quiet this long after sending, so one storm is one push and not
# one push per cron tick. 0 disables.
# ALERT_COOLDOWN_MIN=180
# NEWS_QUERY=top world news today

# Optional - see vocab_drip.py's / kanji_drip.py's / grammar_drip.py's
# own docstrings. All three are active-recall drips sharing scheduled/srs.py
# (spoiler-hidden content, per-item spaced-repetition intervals, an
# unrated-item resurface timeout); only TELEGRAM_BOT_TOKEN and
# TELEGRAM_ALLOWED_CHAT_ID are required (already in ../telegram_bot.env),
# no ANTHROPIC_API_KEY needed. telegram_bot.py itself must be running to
# handle the inline button taps.
#
# vocab_drip.py sends VOCAB_BATCH_SIZE words per push instead of
# kanji/grammar's one item per push - but each word goes out as its own
# Telegram message (with its own Again/Hard/Good/Easy row right under
# it), not bundled into one long message. See cron-notifications.md.
# VOCAB_LEVEL=N3
# VOCAB_BATCH_SIZE=7
# VOCAB_NEW_PER_DAY=16
# VOCAB_UNRATED_RESURFACE_HOURS=3
# VOCAB_TSV_GLOB=/home/projects/Agentic-/simple_agent/N3_vocab_batch*.tsv

# KANJI_LEVEL=N3
# KANJI_NEW_PER_DAY=6
# KANJI_UNRATED_RESURFACE_HOURS=3
# KANJI_CSV_GLOB=/home/projects/Agentic-/simple_agent/N3_kanji_batch*.csv
# GRAMMAR_LEVEL=N3
# GRAMMAR_NEW_PER_DAY=4
# GRAMMAR_UNRATED_RESURFACE_HOURS=3
# GRAMMAR_CSV_GLOB=/home/projects/Agentic-/simple_agent/n3_grammar_batch*.csv
#
# Quiet hours (don't fire while you're asleep) are a cron scheduling
# choice, not an env var - see the example crontab in
# cron-notifications.md, which restricts all three drips to 07:00-23:00 JST.

# Optional - add each drip's items to a Notion database as one row per
# item, alongside the Telegram push. Each deck has its own DB id var but
# they all share one NOTION_API_KEY. Per deck, both its vars must be set
# or that deck's Notion step is skipped; failures are logged per row and
# the Telegram drip still goes out. Share each database with the
# integration. Setup: cron-notifications.md.
# NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# vocab_sinks.py - database needs a title property named 'Word', plus
# (exact names): Reading, Meaning, Particle (助詞 patterns), Example 1,
# Example 2, Example 3 (rich_text), Type, JLPT (select).
# NOTION_VOCAB_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# kanji_sinks.py - database needs a title property named 'Kanji', plus
# (exact names): Reading, Meaning, Component (構成), Confusable (似ている),
# Words, Example (rich_text), JLPT (select).
# NOTION_KANJI_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# grammar_sinks.py - database needs a title property named 'Pattern', plus
# (exact names): Formation (形), Meaning, Nuance, Contrast (対比),
# Example 1, Example 2, Example 3 (rich_text), JLPT (select).
# NOTION_GRAMMAR_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - also append each drip to its own Google Doc, formatted as a
# NotebookLM source (preamble + Heading 2 per item + labelled fields +
# example sentences) for audio overviews, flashcards, infographics. Per
# deck, both GOOGLE_SERVICE_ACCOUNT_JSON and that deck's *_GDOC_ID must be
# set or the step is skipped; failures are logged, Telegram still goes
# out. GOOGLE_SERVICE_ACCOUNT_JSON is a path to a service-account key
# file (shared across all three decks); share each target Doc with that
# account's client_email as Editor. Needs the google-auth package
# (requirements.txt). Setup: cron-notifications.md.
# GOOGLE_SERVICE_ACCOUNT_JSON=/home/deploy/vocab-gdoc-sa.json
# VOCAB_GDOC_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KANJI_GDOC_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GRAMMAR_GDOC_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
