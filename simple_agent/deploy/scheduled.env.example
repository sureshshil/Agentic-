# Copy to scheduled.env (anywhere - deploy/ is a reasonable spot) and
# fill in real values. These are the *extra* env vars rain_alert.py and
# news_digest.py need beyond what's already in telegram_bot.env -
# ANTHROPIC_API_KEY and ANTHROPIC_WORKSPACE_ID are reused as-is from
# there either way; BRAVE_API_KEY (used by news_digest_agent.py, via the
# real telegram_bot.Agent) or TAVILY_API_KEY (used by news_digest.py's
# own bespoke call) is too, whichever script you actually run.
#
# This file is sourced directly in the crontab command (see
# cron-notifications.md), not loaded by the scripts themselves - plain
# KEY=VALUE pairs, no quotes needed.

NTFY_TOPIC=your-ntfy-topic-here

# Optional - see rain_alert.py's and news_digest.py's own docstrings for
# what each defaults to if left unset:
# ALERT_LOCATION=Tokyo, Japan
# RAIN_THRESHOLD_MM=7.5
# NEWS_QUERY=top world news today
